<resources>
    <style name="Base.Theme.REVmeet" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cyan accent -->
        <item name="colorPrimary">#006B72</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F2F6F6</item>
        <item name="colorOnPrimaryContainer">#002021</item>

        <!-- Lime accent -->
        <item name="colorSecondary">#527500</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#DFF2BA</item>
        <item name="colorOnSecondaryContainer">#172600</item>

        <!-- Warm highlight -->
        <item name="colorTertiary">#8C3D00</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFDBCC</item>
        <item name="colorOnTertiaryContainer">#321100</item>

        <!-- Light surfaces -->
        <item name="colorSurface">#FFFBFB</item>
        <item name="colorOnSurface">#131B1C</item>
        <item name="colorSurfaceVariant">#DDE5E5</item>
        <item name="colorOnSurfaceVariant">#404849</item>
        <item name="colorOutline">#697778</item>

        <item name="android:statusBarColor">#F5F7F7</item>
        <item name="android:navigationBarColor">#F5F7F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/helvetica_font</item>
    </style>

    <style name="Theme.REVmeet" parent="Base.Theme.REVmeet" />

    <style name="TextAppearance.REVmeet.ToolbarTitle"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/actuate_font</item>
        <item name="android:fontFamily">@font/actuate_font</item>
    </style>

    <style name="Theme.REVmeet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#02766B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.REVmeet</item>
    </style>
</resources>