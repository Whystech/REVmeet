<resources>


    <style name="Base.Theme.REVmeet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#13022F</item>
        <item name="colorOnPrimary">#8A56BA</item>
        <item name="colorPrimaryContainer">#7115D3</item>
        <item name="colorOnPrimaryContainer">#EFDBFF</item>

        <item name="colorSecondary">#AFC9FF</item>
        <item name="colorOnSecondary">#152E52</item>
        <item name="colorSecondaryContainer">#29456D</item>
        <item name="colorOnSecondaryContainer">#D8E5FF</item>

        <item name="colorTertiary">#3A021E</item>
        <item name="colorOnTertiary">#531D3B</item>
        <item name="colorTertiaryContainer">#713454</item>
        <item name="colorOnTertiaryContainer">#FFD8E9</item>

        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#F0ECF5</item>
        <item name="colorSurfaceVariant">#082E29</item>
        <item name="colorOnSurfaceVariant">#1F0238</item>
        <item name="colorOutline">#00DDE9</item>

        <item name="android:statusBarColor">#100D16</item>
        <item name="android:navigationBarColor">#021A1D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">@font/helvetica_font</item>
    </style>

    <style name="TextAppearance.REVmeet.ToolbarTitle"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/actuate_font</item>
        <item name="android:fontFamily">@font/actuate_font</item>
    </style>
    <style name="Theme.REVmeet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#45206B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.REVmeet</item>
    </style>
</resources>