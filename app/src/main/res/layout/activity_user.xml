<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar for the user form. -->
    <!-- margin for safe zone -->
    <com.google.android.material.appbar.MaterialToolbar
        app:titleTextAppearance="@style/TextAppearance.REVmeet.ToolbarTitle"
        android:id="@+id/toolbarUser"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="30dp"
        app:title="@string/button_addUser"/>

    <!--  Scrollable form content. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--  User name input. -->
            <EditText
                android:id="@+id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/userName"
                android:inputType="textPersonName|textCapWords" />
            <!-- Display Name -->
            <EditText
                android:id="@+id/userDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/userDisplayName"
                android:inputType="text" />

            <!--  Email input. -->
            <EditText
                android:id="@+id/userEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/userEmail"
                android:inputType="textEmailAddress" />

            <!-- Bio -->
            <EditText
                android:id="@+id/userBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/userBio"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"/>



        </LinearLayout>
    </ScrollView>
</LinearLayout>