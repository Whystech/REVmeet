<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="org.ianus.revmeet.main.MainApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.REVmeet">

<!-- Meeting list activity -->
        <activity
            android:name=".views.meetinglist.MeetingListView"
            android:exported="true"
            android:theme="@style/Theme.REVmeet.Splash"
            android:windowSoftInputMode="adjustResize">>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
<!-- Meeting view activity -->
        <activity
            android:name=".views.meeting.MeetingView"
            android:exported="false" />

<!-- Meeting details activity-->
        <activity
            android:name=".views.meeting.MeetingDetailView"
            android:exported="false" />

<!-- User list activity -->
        <activity
            android:name=".views.userlist.UserListView"
            android:exported="false" />
<!-- User add activity -->
        <activity
            android:name=".views.user.UserView"
            android:exported="false" />
<!-- User details activity -->
        <activity
            android:name=".views.userdetails.UserDetailView"
            android:exported="false" />

<!-- Add participants activity -->
        <activity
            android:name=".views.participants.AddParticipantsView"
            android:exported="false" />

<!-- Remove participants activity -->
        <activity
            android:name=".views.participants.RemoveParticipantsView"
            android:exported="false" />

<!-- List participants w/details activity -->
        <activity
            android:name=".views.participants.ListParticipantsView"
            android:exported="false" />
    </application>
</manifest>